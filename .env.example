# Busybookie large-media storage root.
# Keep generated video/audio/images off the system SSD.
BUSYBOOKIE_MEDIA_ROOT=D:/Busybookie/Production

# API credentials.
# Never commit real credentials.
RUNWAYML_API_SECRET=
GEMINI_API_KEY=

# Optional post-production executable overrides.
# Leave blank to resolve ffmpeg and ffprobe from PATH.
BUSYBOOKIE_FFMPEG_PATH=
BUSYBOOKIE_FFPROBE_PATH=
