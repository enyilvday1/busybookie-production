    "validate:episode": "tsx src/validation/validateEpisodeManifest.ts",
    "validate:runtime": "tsx src/validation/validateRuntime.ts",
    "runway:gen45": "tsx scripts/runway-gen45.ts",
    "veo:generate": "tsx scripts/veo.ts",
    "routing:report": "tsx scripts/routing-report.ts",
    "execution:plan": "tsx scripts/execution-plan.ts",
    "execution:generate": "tsx scripts/execution-generate.ts",
    "execution:reconcile": "tsx scripts/execution-reconcile.ts",
    "dialogue:generate": "tsx scripts/dialogue-generate.ts",
    "dialogue:reconcile": "tsx scripts/dialogue-reconcile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
